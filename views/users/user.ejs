<% layout("/layouts/boilerplate.ejs") %>
 

   <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<section class="container my-5">
  <div class="card shadow-sm">
    <div class="card-body">
      <h3 class="card-title mb-3"> 👤User Profile</h3>
      <p class="mb-1"><strong>Username:</strong> <%= user.username %></p>
      <p class="mb-1"><strong>Email:</strong> <%= user.email %></p>
      
    </div>
  </div>
</section>


<section class="container my-5">
  <h2 class="mb-4">📌 Your Listings</h2>
  <% if (listings.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% listings.forEach(listing => { %>
        <div class="col">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text text-muted"><i class="bi bi-geo-alt-fill"></i> <%= listing.location %></p>
              <a href="/listing/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
            <a href="/listing/<%= listing._id %>/bookings" class="btn btn-outline-secondary btn-sm">View Bookings</a>
    <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#unavailableModal-<%= listing._id %>"> Set Unavailable Dates </button>
<div class="modal fade" id="unavailableModal-<%= listing._id %>" tabindex="-1" aria-labelledby="unavailableLabel-<%= listing._id %>" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/listing/<%= listing._id %>/unavailable" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="unavailableLabel-<%= listing._id %>">Set Unavailable Dates</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="start-<%= listing._id %>" class="form-label">Start:</label>
            <input type="text" id="start-<%= listing._id %>" name="start" class="form-control" required>
          </div>
          <div class="mb-3">
            <label for="end-<%= listing._id %>" class="form-label">End:</label>
            <input type="text" id="end-<%= listing._id %>" name="end" class="form-control" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Confirm dates</button>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
 
  const start = flatpickr("#start-<%= listing._id %>", {
    dateFormat: "Y-m-d",
    minDate: "today",
    onChange: function(selectedDates, dateStr, instance) {
      if (selectedDates.length > 0) {
        end.set("minDate", dateStr);
      }
    }
  }); const end= flatpickr("#end-<%= listing._id %>", {
    dateFormat: "Y-m-d",
    minDate: "today"
  });

</script>
</div>
 </div>
          </div>
      <% } %>
        </div>

  <% } else { %>
    <div class="alert alert-info">No listings yet.</div>
  <% } %>
</section>
<section class="container my-5">
  <h2 class="mb-4">📅 Your Bookings</h2>
 

  <% if (bookings.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% bookings.forEach(booking => { %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title">
  <%= booking.listingId ? booking.listingId.title : "Listing unavailable" %>
</h5>

              <p class="card-text">
                <strong>From:</strong> <%= booking.checkIn %><br>
                <strong>To:</strong> <%= booking.checkOut %><br>
                <strong>Status:</strong> 
                <span class="badge 
                  <%= booking.status === 'Confirmed' ? 'bg-success' : booking.status === 'Cancelled' ? 'bg-danger' : 'bg-warning text-dark' %>">
                  <%= booking.status %>
                </span>
              </p>
              <% if(booking.status=='Confirmed') { %> 
             <form action="/bookings/<%= booking._id %>/cancel" method="POST">
                <button class="btn btn-danger btn-sm">Cancel</button>
              </form>
              <% } %>
              </div>
            </div>
          </div>
         
      <% }) %>
  </div>
  <% } else { %>
    <div class="alert alert-info">You haven't made any bookings yet.</div>
  <% } %>
</section>
