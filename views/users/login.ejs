<% layout("/layouts/boilerplate.ejs") %>
<% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
<form action="/login"  method="POST" style="max-width:440px; margin:2.5rem auto; padding:2rem 1.5rem  ;background:#f8f9fa; border-radius:12px; box-shadow:0 2px 14px rgba(0,0,0,0.08);">
  <h3 class="mb-4  text-center fw-bold">Login</h3>
  <div class="mb-4">
    <label for="username" class="form-label fw-semibold">Username</label>
    <input type="text" class="form-control" id="username" name="username" required autocomplete="off" style="height:48px;">
  </div>
  
  <div class="mb-4">
    <label for="password" class="form-label fw-semibold">Password</label>
    <input type="password" class="form-control" id="password" name="password" required autocomplete="off" style="height:48px;">
  </div>
  <button type="submit" class="btn btn-dark w-100 btn-md">Login</button>
  <div class="text-center mt-3">
  
  <a href="/auth/google" class="btn btn-outline-primary btn-sm mt-1">Login with <i class="fab fa-google"></i>
</a>
  <a href="/signup" class="btn btn-outline-primary btn-sm mt-1">Sign Up Here</a>
  <a href="/forget" class="btn btn-outline-primary btn-sm mt-1">Forgot Password</a>
</div>
</form>