<% layout("/layouts/boilerplate.ejs") %>
<body>
<% if (success && success.length > 0) { %>
  <div class="alert alert-dismissible fade show  alert-success text-center fw-bold">
    <%= success[0] %>
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
  <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
<div class="container mb-3">
  <div class="d-flex justify-content-center gap-3 category-icons">
    <div class="text-center">
      <a href="/listing/category/Luxury" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-gem"></i></span>
        <div class="small mt-1">Luxury</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Budget" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-cash-stack"></i></span>
        <div class="small mt-1">Budget</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Family" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-people-fill"></i></span>
        <div class="small mt-1">Family</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Business" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-briefcase-fill"></i></span>
        <div class="small mt-1">Business</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Resort" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-tree-fill"></i></span>
        <div class="small mt-1">Resort</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Homestay" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-house-heart-fill"></i></span>
        <div class="small mt-1">Homestay</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Beach" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-water"></i></span>
        <div class="small mt-1">Beach</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Boutique" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-moon-stars-fill"></i></span>
        <div class="small mt-1">Boutique</div>
      </a>
    </div>
    <div class="text-center">
      <a href="/listing/category/Wellness" class="text-decoration-none">
        <span class="fs-4 category-icon"><i class="bi bi-hospital-fill"></i></span>
        <div class="small mt-1">Wellness</div>
      </a>
    </div>
  </div>
</div>

<div class="container my-4">
  <div class="row">
    <% for(let i = 0; i < alllist.length; i++) { 
         let listing = alllist[i]; %>
         
      <div class="col-12 col-sm-6 col-md-4 mb-4 d-flex align-items-stretch">
       
        <div class="image">
        <div class="card w-100 shadow"> <a href="/listing/<%= listing._id %>" class="listing-link">
          <div class="card-img-overlay-wrapper position-relative">
  <img src="<%= listing.image.url ? listing.image.url : '/images/default.webp'%>" class="card-img-top" alt="Listing Image" style="height:220px; background:#f8f9fa;object-fit:cover;">
</div>
        </a> </div>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= listing.title %></h5>
            <p class="card-text text-muted mb-1"><i class="bi bi-geo-alt"></i> <%= listing.location %></p>
            <p class="card-text flex-grow-1"><%= listing.description%>...</p>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <span class="badge bg-success">&#8377; <%= listing.price %>/night</span>
              
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>




     


</body>
