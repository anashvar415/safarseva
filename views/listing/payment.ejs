 <% layout("/layouts/boilerplate.ejs") %>
 
    <div class="card shadow-lg border-0 w-100" style="max-width: 500px;">
      <div class="card-body text-center p-5">
        <div class="mb-4">
          <div class="display-1 text-success">✔</div>
          <h2 class="fw-bold mt-3">Payment Successful</h2>
          <p class="text-muted">Your booking has been confirmed. Thank you!</p>
        </div>

        <ul class="list-group list-group-flush text-start mb-4">
          <li class="list-group-item">
            <strong>Transaction ID: </strong><%= transactionId  %>
          </li>
          <% 
  const checkInDate = new Date(checkIn);
  const checkOutDate = new Date(checkOut);
  const durationInMs = checkOutDate - checkInDate;
  const numberOfDays = Math.ceil(durationInMs / (1000 * 60 * 60 * 24));
%>


          <li class="list-group-item">
            <strong>Amount Paid:</strong> ₹<%= listingData.price*numberOfDays + (listingData.price*numberOfDays) *0.18%>(inclusive of all taxes)
          </li>
          <li class="list-group-item">
            <strong>Date:</strong> <%=new Date().toLocaleDateString()   %>
          </li>
        </ul>
        <a href="/dashboard" class="btn btn-success w-100">Go to Dashboard</a>

    </div>
  </div>
