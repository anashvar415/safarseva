 <% layout("/layouts/boilerplate.ejs") %>
 <% if (success && success.length > 0) { %>
  <div class="alert alert-dismissible fade show  alert-success text-center fw-bold">
    <%= success[0] %>
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
  <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
 <div class="d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg border-0 w-100 " style="max-width: 500px;">
      <div class="card-body text-center p-5">
        <div class="mb-4">
          <div class="display-1 text-success">✔</div>
          <h2 class="fw-bold mt-3">Payment Successful</h2>
          <p class="text-muted">Your booking has been confirmed. Thank you!</p>
        </div>

        <ul class="list-group list-group-flush text-start mb-4">
          <li class="list-group-item">
            <strong>Transaction ID: </strong><%= transactionId  %>
          </li>
          <% 
  const checkInDate = new Date(checkIn);
  const checkOutDate = new Date(checkOut);
  const durationInMs = checkOutDate - checkInDate;
  const numberOfDays = Math.ceil(durationInMs / (1000 * 60 * 60 * 24));
%>
<li class="list-group-item">
  <strong>Amount Paid:</strong> ₹<%= (listingData.price * numberOfDays * 1.18).toFixed(2) %>
</li>

          <li class="list-group-item">
            <strong>Date:</strong> <%=new Date().toLocaleDateString()   %>
          </li>
        </ul>
        <a href="/dashboard" class="btn btn-success w-100">Go to Dashboard</a>

    </div>
  </div>
 </div>