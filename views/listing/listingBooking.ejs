<% layout("/layouts/boilerplate.ejs") %>
 

   <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
<section class="container my-5">
  <h2 class="mb-4">📋 Bookings for "<%= listing.title %>"</h2>
  <% if (bookings.length > 0) { %>
    <div class="list-group">
      <% bookings.forEach(booking => { %>
        <div class="list-group-item">
          <h5 class="mb-1">Booked by: <%= booking.userId.username %></h5>
          <p class="mb-1">
            From: <%= booking.checkIn.toDateString() %> <br>
            To: <%= booking.checkOut.toDateString() %> <br>
            Status: 
            <span class="badge 
              <%= booking.status === 'Confirmed' ? 'bg-success' : booking.status === 'Cancelled' ? 'bg-danger' : 'bg-warning text-dark' %>">
              <%= booking.status %>
            </span>
          </p>
           <h5 class="mb-1">Set Unavailable Dates</h5>
  <form action="/listing/<%= listingData._id %>/unavailable" method="POST" class="p-4 border rounded shadow-sm bg-light">
    <div class="mb-3">
      <label for="start" class="form-label">Start:</label>
      <input type="text" id="start" name="start" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="end" class="form-label">End:</label>
      <input type="text" id="end" name="end" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-primary">Confirm dates</button>
  </form>
</div>
          <div class="d-flex gap-2">
            <% if (booking.status !== 'Confirmed'||booking.status === 'Pending') { %>
              <form action="/bookings/<%= booking._id %>/confirm" method="POST">
                <button class="btn btn-success btn-sm">Confirm</button>
              </form>
            <% } %>
            <% if (booking.status !== 'Cancelled') { %>
              <form action="/bookings/<%= booking._id %>/cancel" method="POST">
                <button class="btn btn-danger btn-sm">Cancel</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert" >
   No Bookings for this listing yet.
   
  </div>
  <% } %>
</section>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  const start = flatpickr("#start", {
    dateFormat: "Y-m-d",
    minDate: "today",
    onChange: function(selectedDates, dateStr, instance) {
      if (selectedDates.length > 0) {
        end.set("minDate", dateStr);
      }
    }
  });

  const end= flatpickr("#end", {
    dateFormat: "Y-m-d",
    minDate: "today"
  });
</script>