<% layout("/layouts/boilerplate.ejs") %>
 

   <% if (error && error.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show text-center fw-bold" role="alert">
    <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>



<form action="/listings/<%= listing._id %>/book" method="POST">
  <label for="checkIn">Select Date Range:</label>
  <input id="dateRange" name="dateRange" type="text" required>

  <input type="hidden" name="checkIn" id="checkIn">
  <input type="hidden" name="checkOut" id="checkOut">

  <button type="submit" id="submitBtn" class="btn btn-success">Confirm Booking</button>
</form>
<script>
  flatpickr("#dateRange", {
    mode: "range",
    dateFormat: "Y-m-d",
    minDate: "today",
    disable: <%- JSON.stringify(listing.unavailableDates.map(d => ({ from: d.start, to: d.end }))) %>,
    onChange: function(selectedDates) {
      if (selectedDates.length === 2) {
        document.getElementById("checkIn").value = selectedDates[0].toISOString().split('T')[0];
        document.getElementById("checkOut").value = selectedDates[1].toISOString().split('T')[0];
        document.getElementById("submitBtn").disabled = false;

      }
    }
  });
</script>