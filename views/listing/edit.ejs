<% layout("/layouts/boilerplate.ejs") %>
<body>
    <form action="/listing/<%= listingData._id %>?_method=PUT" method="POST" class="bg-white shadow p-4" style="max-width: 600px; margin: 2rem auto;">
  <h2 class="mb-4 text-center fw-bold" style="letter-spacing:1px; color:#222;">Edit Listing</h2>
  <div class="mb-3">
    <label for="title" class="form-label fw-semibold">Title</label>
    <input type="text" class="form-control form-control-lg" id="title" name="listing[title]" required autocomplete="off" value="<%= listingData.title %>">
  </div>
  <div class="mb-3">
    <label for="description" class="form-label fw-semibold">Description</label>
    <textarea class="form-control form-control-lg" id="description" name="listing[description]" rows="3" required style="resize:vertical;"><%= listingData.description %></textarea>
  </div>
  <div class="mb-3">
    <label for="price" class="form-label fw-semibold">Price (₹)</label>
    <input type="number" class="form-control form-control-lg" id="price" name="listing[price]" min="0" required value="<%= listingData.price %>">
  </div>
  <div class="mb-3">
    <label for="location" class="form-label fw-semibold">Location</label>
    <input type="text" class="form-control form-control-lg" id="location" name="listing[location]" required autocomplete="off" value="<%= listingData.location %>">
  </div>
 
  <button type="submit"  class="btn btn-outline-primary btn-sm w-50">Update</button>
</form>
</body>
